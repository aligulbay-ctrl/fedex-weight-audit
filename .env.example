# Postgres connection string (Vercel Postgres, Neon, Supabase Postgres vb.)
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Asagidakiler OPSIYONEL ---
# FedEx Client ID / Secret ve fark esigini artik uygulamanin icindeki
# "Ayarlar" sayfasindan girebilirsiniz (redeploy gerekmez, veritabaninda
# saklanir). Burasi sadece Vercel env degiskeni tercih edenler icin bir
# fallback: Ayarlar sayfasinda bos birakilan alanlar icin kullanilir.
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Sandbox: https://apis-sandbox.fedex.com | Production: https://apis.fedex.com
FEDEX_API_BASE=https://apis.fedex.com
DISCREPANCY_THRESHOLD_KG=0.5
DISCREPANCY_THRESHOLD_PCT=5

# Vercel Blob'u projenize baglarsaniz (bkz. README "Kurulum -> 5) Vercel
# Blob") Vercel bu degiskeni OTOMATIK ekler - siz elle girmezsiniz. Sadece
# yerelde test etmek isterseniz Vercel panelinizden (Storage -> Blob store
# -> .env.local sekmesi) kopyalayip buraya yapistirabilirsiniz.
BLOB_READ_WRITE_TOKEN=
